# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_placeholder
POSTGRES_DB=tinchaka_db

# Database Connection URL (used by Prisma and API)
DATABASE_URL=postgresql://postgres:postgres_password_placeholder@tinchaka-db:5432/tinchaka_db?schema=public

# Authentication Secrets
JWT_SECRET=replace-me-with-a-long-random-string

# API Service Configuration
PORT=3001

# Web Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
